# Sender account for the daily HQ report (Gmail + App Password).
# Copy to `.env` and fill in — never commit the real file.
#
# Where the app looks for `.env` (first hit wins):
#   1. the app's user-data dir (Windows: %APPDATA%\yft-pos\.env)
#   2. next to the installed executable
#   3. the working directory (development)
#
# The list of recipient emails is NOT stored here — it lives in the app's
# SQLite settings (Items → Settings → "HQ emails"), one address per line.

SMTP_USER=pos.yunfook@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
